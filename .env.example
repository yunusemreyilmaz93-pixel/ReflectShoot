# Public Firebase web configuration (values are safe to expose only when rules are strict)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin configuration
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use the three variables below instead of FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only Cloudflare R2 configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=

# Server-only, at least 32 random characters
VOTE_HASH_SALT=

# Optional server-only e-mail (server/email.js no-ops when unset)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
PUBLIC_SITE_URL=
