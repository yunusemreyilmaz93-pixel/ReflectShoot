
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    // 1. USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || hasRole('ADMIN'));
    }

    // 2. APPLICATIONS
    match /applications/{appId} {
      // Allow read if Admin, Judge, Owner, OR if it's a Finalist (for Public Vote)
      allow read: if (isSignedIn() && (
        hasRole('ADMIN') || 
        hasRole('JUDGE') || 
        (hasRole('TEACHER') && resource.data.teacher.email == request.auth.token.email)
      )) || (resource.data.team.isFinalist == true);
      
      allow create: if hasRole('TEACHER') || hasRole('ADMIN');
      allow update: if hasRole('ADMIN') || (hasRole('TEACHER') && resource.data.teacher.email == request.auth.token.email) || hasRole('JUDGE');
      
      // SUBCOLLECTIONS
      match /scores/{juryId} {
        allow read: if hasRole('ADMIN') || (hasRole('JUDGE') && request.auth.uid == juryId);
        allow write: if hasRole('JUDGE') && request.auth.uid == juryId;
      }

      match /messages/{msgId} {
        allow read: if hasRole('ADMIN') || (hasRole('TEACHER') && get(/databases/$(database)/documents/applications/$(appId)).data.teacher.email == request.auth.token.email);
        allow create: if hasRole('ADMIN') || hasRole('TEACHER');
      }
    }

    // 3. NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. PUBLIC VOTES
    match /public_votes/{voteId} {
      allow create: if true;
      allow read: if true;
    }

    // 5. AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if hasRole('ADMIN');
      allow create: if isSignedIn();
    }

    // 6. SYSTEM SETTINGS
    match /system/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }

    // 7. CMS CONTENT (Dynamic Match for all cms_ collections)
    match /{path=**}/cms_general/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_faqs/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_gallery/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_academy/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_timeline/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_prizes/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /{path=**}/cms_links/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    
    // Direct match as fallback
    match /cms_general/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_faqs/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_gallery/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_academy/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_timeline/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_prizes/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_links/{document=**} { allow read: if true; allow write: if hasRole('ADMIN'); }
  }
}
