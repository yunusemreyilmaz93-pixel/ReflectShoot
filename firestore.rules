rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return hasProfile() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isVerifiedRole(role) {
      return hasRole(role) && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isApplicationOwnerData(data) {
      return isSignedIn() && data.teacher.id == request.auth.uid;
    }

    function ownsApplication(appId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/applications/$(appId)).data.teacher.id == request.auth.uid;
    }

    function isNotRateLimited() {
      return !hasProfile() ||
        !('lastActionAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastActionAt + duration.value(2, 's');
    }

    function validApplicationCreate(appId) {
      return request.resource.data.keys().hasOnly([
          'id', 'teacher', 'team', 'status', 'submittedAt', 'updatedAt',
          'seasonId', 'archived'
        ]) &&
        request.resource.data.id == appId &&
        request.resource.data.teacher.id == request.auth.uid &&
        request.resource.data.status == 'Taslak' &&
        // 2026-27 season: a single category and theme.
        request.resource.data.team.category == 'Yapay Zeka Animasyon' &&
        request.resource.data.team.theme == 'Asr ve Beled Sureleri' &&
        request.resource.data.team.name is string &&
        request.resource.data.team.name.size() >= 3 &&
        request.resource.data.team.name.size() <= 40 &&
        request.resource.data.team.students is list &&
        request.resource.data.team.students.size() >= 2 &&
        request.resource.data.team.students.size() <= 4 &&
        // Season tags optional; client may not archive on create
        (!('archived' in request.resource.data) || request.resource.data.archived == false) &&
        (!('seasonId' in request.resource.data) ||
          (request.resource.data.seasonId is string &&
            request.resource.data.seasonId.size() >= 2 &&
            request.resource.data.seasonId.size() <= 32));
    }

    // Statuses in which the owner may still edit the application (mirrors OWNER_WRITABLE_STATUSES).
    // Once an admin/jury has moved it elsewhere (approved, scored, rejected, disqualified...)
    // the owner can no longer reset it back into the editable pipeline.
    function ownerEditableStatus(status) {
      return status in ['Taslak', 'Ön Başvuru Yapıldı', 'Video İnceleniyor', 'Düzeltme Gerekli'];
    }

    function isHttpsUrl(value) {
      return value is string && value.matches('^https://[^\\s]+$');
    }

    // A URL field may stay as-is (legacy data) or be set to null/https only.
    function urlFieldUnchangedOrSafe(field) {
      return request.resource.data.team.get(field, null) == resource.data.team.get(field, null) ||
        request.resource.data.team.get(field, null) == null ||
        isHttpsUrl(request.resource.data.team.get(field, null));
    }

    // Winners flag their award participation form as submitted; nothing else may change.
    function validOwnerParticipationFlagUpdate() {
      return resource.data.team.get('isWinner', false) == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team']) &&
        request.resource.data.team.diff(resource.data.team).affectedKeys()
          .hasOnly(['participationFormStatus', 'participationSubmittedAt']) &&
        request.resource.data.team.participationFormStatus == 'submitted';
    }

    function validOwnerApplicationUpdate() {
      return ownerEditableStatus(resource.data.status) &&
        request.resource.data.teacher == resource.data.teacher &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['team', 'status', 'submittedAt', 'updatedAt']) &&
        request.resource.data.team.diff(resource.data.team).affectedKeys().hasOnly([
          'name', 'logoUrl', 'logoKey', 'students', 'submissionDownloadUrl', 'videoUrl',
          'videoStatus', 'isPreliminaryStageComplete', 'isFinalStageComplete',
          'participationFormStatus', 'participationSubmittedAt'
        ]) &&
        request.resource.data.team.name is string &&
        request.resource.data.team.name.size() >= 3 &&
        request.resource.data.team.name.size() <= 40 &&
        request.resource.data.team.students is list &&
        request.resource.data.team.students.size() >= 2 &&
        request.resource.data.team.students.size() <= 4 &&
        request.resource.data.status in [
          'Taslak', 'Ön Başvuru Yapıldı', 'Video İnceleniyor', 'Düzeltme Gerekli'
        ] &&
        (!('videoUrl' in request.resource.data.team) ||
          request.resource.data.team.videoUrl.matches('^https://(www\\.)?(youtube\\.com|youtu\\.be)/.*$')) &&
        urlFieldUnchangedOrSafe('logoUrl') &&
        urlFieldUnchangedOrSafe('submissionDownloadUrl');
    }


    function validDashboardContact() {
      return isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'title', 'message', 'createdAt', 'status', 'source', 'applicationId'
        ]) &&
        request.resource.data.source == 'DASHBOARD_CHAT' &&
        request.resource.data.email is string &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
        request.resource.data.title is string && request.resource.data.title.size() <= 160 &&
        request.resource.data.status == 'UNREAD' &&
        ownsApplication(request.resource.data.applicationId) &&
        request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 3000;
    }

    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_prizes/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /cms_faq/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /cms_gallery/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /cms_academy/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /cms_timeline/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /academycontent/{doc} { allow read: if true; allow write: if isAdmin(); }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['PENDING_TEACHER', 'STUDENT'] &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'fullName', 'school', 'city', 'phone', 'role',
          'createdAt', 'emailVerified', 'lastActionAt'
        ]);
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'school', 'city', 'phone', 'emailVerified', 'lastActionAt']));
      // Account removal (Auth user, notifications) runs on the server only: /api/admin-delete-user.
      allow delete: if false;
    }

    match /applications/{appId} {
      // Jury members never read application documents (student and advisor personal data):
      // they receive a stripped view from /api/jury-applications.
      allow read: if isAdmin() || isApplicationOwnerData(resource.data);
      allow create: if (isVerifiedRole('TEACHER') || isVerifiedRole('STUDENT')) &&
        isNotRateLimited() && validApplicationCreate(appId);
      allow update: if isAdmin() ||
        ((isVerifiedRole('TEACHER') || isVerifiedRole('STUDENT')) &&
          isApplicationOwnerData(resource.data) && isNotRateLimited() &&
          (validOwnerApplicationUpdate() || validOwnerParticipationFlagUpdate()));
      // Deletion (files in R2, scores, chat, participation form) runs on the server only:
      // /api/admin-delete-application.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || ownsApplication(appId);
        allow create: if (isAdmin() || ownsApplication(appId)) &&
          request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderRole', 'text', 'createdAt'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRole ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 3000;
        allow update, delete: if isAdmin();
      }
    }

    // Scores are written by the server transaction only. A judge may read only their own score
    // documents (this rule also covers the collection-group query on `juryId`).
    match /{path=**}/scores/{scoreDocId} {
      allow read: if isAdmin() ||
        (isVerifiedRole('JUDGE') && resource.data.juryId == request.auth.uid);
      allow write: if false;
    }

    match /award_participations/{appId} {
      allow read: if isAdmin() || ownsApplication(appId);
      allow create: if ownsApplication(appId) &&
        get(/databases/$(database)/documents/applications/$(appId)).data.team.get('isWinner', false) == true &&
        request.resource.data.applicationId == appId &&
        request.resource.data.status in ['draft', 'submitted'];
      allow update: if isAdmin() ||
        (ownsApplication(appId) &&
          resource.data.status != 'submitted' &&
          request.resource.data.applicationId == appId &&
          request.resource.data.status in ['draft', 'submitted']);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /contact_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /contact_messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if validDashboardContact();
    }

    // Audit entries are written by the server (identity, IP and time are not client-controlled).
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
