
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Fetch user role from 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check for specific role
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    // --- 1. USERS ---
    match /users/{userId} {
      allow read: if isSignedIn(); // Allow reading profiles (needed for admin/jury lists)
      allow write: if isOwner(userId) || hasRole('ADMIN');
    }

    // --- 2. APPLICATIONS ---
    match /applications/{appId} {
      // READ PERMISSIONS:
      // - Admin: All
      // - Judge: All (needed for querying filtering)
      // - Teacher: Own application
      // - Public: Only if isFinalist is true (for voting page)
      allow read: if hasRole('ADMIN') || 
                     hasRole('JUDGE') || 
                     (hasRole('TEACHER') && resource.data.teacher.email == request.auth.token.email) || 
                     resource.data.team.isFinalist == true;
      
      // CREATE: Teachers and Admins
      allow create: if hasRole('TEACHER') || hasRole('ADMIN');
      
      // UPDATE:
      // - Admin: All fields
      // - Teacher: Own application
      // - Judge: Needs update permission on parent doc to update 'finalScore', 'juryCount', 'gradedBy'
      // - Public: Public vote increment (restricted by logic usually, but allowed here for simplicity)
      allow update: if hasRole('ADMIN') || 
                       (hasRole('TEACHER') && resource.data.teacher.email == request.auth.token.email) || 
                       hasRole('JUDGE') ||
                       (resource.data.team.isFinalist == true); // For public votes increment

      // SUBCOLLECTION: SCORES
      match /scores/{juryId} {
        allow read: if hasRole('ADMIN') || (hasRole('JUDGE') && isOwner(juryId));
        allow write: if hasRole('JUDGE') && isOwner(juryId);
      }

      // SUBCOLLECTION: MESSAGES (Chat)
      match /messages/{msgId} {
        allow read: if hasRole('ADMIN') || (hasRole('TEACHER') && get(/databases/$(database)/documents/applications/$(appId)).data.teacher.email == request.auth.token.email);
        allow create: if hasRole('ADMIN') || hasRole('TEACHER');
      }
    }

    // --- 3. NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn(); // Allow triggering notifications
      allow update: if isOwner(resource.data.userId); // Mark as read
    }

    // --- 4. PUBLIC VOTES ---
    match /public_votes/{voteId} {
      allow read: if true; // Needed to check for duplicate votes by fingerprint
      allow create: if true; // Public voting allowed
    }

    // --- 5. AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if hasRole('ADMIN');
      allow create: if isSignedIn();
    }

    // --- 6. CONTACT MESSAGES (New Feature) ---
    match /contact_messages/{msgId} {
      allow read: if hasRole('ADMIN'); // Only Admin can read inbox
      allow create: if true; // Anyone (Public) can send message
      allow update: if hasRole('ADMIN'); // Mark as read
    }

    // --- 7. SYSTEM SETTINGS ---
    match /system/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }

    // --- 8. CMS CONTENT ---
    // Explicit matches for all CMS collections
    match /cms_general/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_links/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_faqs/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_gallery/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_academy/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_timeline/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_prizes/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
  }
}
