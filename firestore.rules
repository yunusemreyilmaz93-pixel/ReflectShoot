
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the resource (based on uid)
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Fetch user data to check roles
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check for specific role
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    // --- 1. SYSTEM SETTINGS & CMS (Public Read) ---
    // AppContext reads from 'settings/config'
    match /settings/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }
    
    // AppContext reads from 'cms/general' and 'cms/links'
    match /cms/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }

    // Specific CMS Collections
    match /cms_prizes/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_faqs/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_gallery/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_academy/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_timeline/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }

    // --- 2. USERS ---
    match /users/{userId} {
      allow read: if isSignedIn(); // Users need to read profiles (e.g. for Jury assignments)
      allow write: if isOwner(userId) || hasRole('ADMIN');
    }

    // --- 3. APPLICATIONS ---
    match /applications/{appId} {
      // READ:
      // - Admin & Judge: All
      // - Teacher: Own application
      // - Public: Finalists (for public voting/viewing)
      allow read: if hasRole('ADMIN') || 
                     hasRole('JUDGE') || 
                     (hasRole('TEACHER') && resource.data.teacher.id == request.auth.uid) || 
                     resource.data.team.isFinalist == true;
      
      // CREATE: Teachers and Admins
      allow create: if hasRole('TEACHER') || hasRole('ADMIN');
      
      // UPDATE:
      // - Admin: All
      // - Teacher: Own application
      // - Judge: Update application status/scoring metadata
      // - Public: Indirectly via Cloud Functions usually, but allowed here for finalist flag updates or votes if handled client side
      allow update: if hasRole('ADMIN') || 
                       (hasRole('TEACHER') && resource.data.teacher.id == request.auth.uid) || 
                       hasRole('JUDGE') ||
                       (resource.data.team.isFinalist == true); 

      // Scores Subcollection
      match /scores/{juryId} {
        allow read: if hasRole('ADMIN') || (hasRole('JUDGE') && isOwner(juryId));
        allow write: if hasRole('JUDGE') && isOwner(juryId);
      }

      // Messages Subcollection (Chat)
      match /messages/{msgId} {
        allow read: if hasRole('ADMIN') || (hasRole('TEACHER') && get(/databases/$(database)/documents/applications/$(appId)).data.teacher.id == request.auth.uid);
        allow create: if hasRole('ADMIN') || hasRole('TEACHER');
      }
    }

    // --- 4. NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn(); 
      allow update: if isOwner(resource.data.userId); // Mark as read
    }

    // --- 5. PUBLIC VOTES ---
    // AppContext uses 'votes' collection
    match /votes/{voteId} {
      allow read: if true; // Needed to check previous votes by fingerprint
      allow create: if true; // Public voting
    }

    // --- 6. CONTACT MESSAGES ---
    match /contact_messages/{msgId} {
      allow read: if hasRole('ADMIN');
      allow create: if true; // Public contact form
      allow update: if hasRole('ADMIN');
    }

    // --- 7. AUDIT LOGS ---
    match /logs/{logId} {
      allow read: if hasRole('ADMIN');
      allow create: if isSignedIn();
    }
  }
}
