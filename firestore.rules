rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() 
             ? (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                : null)
             : null;
    }

    function hasRole(role) {
      let userData = getUserData();
      return isSignedIn() &&
             userData != null &&
             (userData.role == role || userData.role == role.lower());
    }

    function isNotRateLimited() {
      let userData = getUserData();
      return userData == null ||
             !('lastActionAt' in userData) ||
             request.time > userData.lastActionAt + duration.value(10, 's');
    }

    // --- 1. SYSTEM & CMS ---
    match /system/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }

    match /cms/{document=**} {
      allow read: if true;
      allow write: if hasRole('ADMIN');
    }

    match /cms_prizes/{doc}   { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_faq/{doc}      { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_gallery/{doc}  { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_academy/{doc}  { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /cms_timeline/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /academycontent/{doc} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /award_participations/{docId} { 
      allow read: if isSignedIn(); 
      allow write: if isSignedIn(); 
    }

    // --- 2. USERS ---
    match /users/{userId} {
      allow read:   if isOwner(userId) || hasRole('ADMIN');
      allow create: if isOwner(userId) &&
                       (request.resource.data.role == 'PENDING_TEACHER' ||
                        request.resource.data.role == 'TEACHER' ||
                        request.resource.data.role == 'STUDENT');
      allow update: if hasRole('ADMIN') ||
                       (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if hasRole('ADMIN'); // ← eklendi
    }

    // --- 3. APPLICATIONS ---
    match /applications/{appId} {
      allow get: if hasRole('ADMIN') || hasRole('REPORTER') ||
                    ((hasRole('TEACHER') || hasRole('STUDENT')) && resource.data.teacher.id == request.auth.uid) ||
                    (hasRole('JUDGE') && request.auth.uid in resource.data.assignedJuryIds) ||
                    resource.data.team.isFinalist == true;

      allow list: if hasRole('ADMIN') || hasRole('REPORTER') ||
                     ((hasRole('TEACHER') || hasRole('STUDENT')) && resource.data.teacher.id == request.auth.uid) || 
                     (hasRole('JUDGE') && request.auth.uid in resource.data.assignedJuryIds) || 
                     resource.data.team.isFinalist == true;

      allow create: if (hasRole('TEACHER') || hasRole('STUDENT') || hasRole('ADMIN')) && isNotRateLimited();

      allow update: if hasRole('ADMIN') ||
                       (((hasRole('TEACHER') || hasRole('STUDENT')) && resource.data.teacher.id == request.auth.uid) && isNotRateLimited()) ||
                       (hasRole('JUDGE') &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gradedBy', 'finalScore', 'juryCount', 'status'])
                       );

      allow delete: if hasRole('ADMIN'); // ← eklendi

      match /scores/{juryId} {
        allow read:  if hasRole('ADMIN') || hasRole('JUDGE');
        allow write: if hasRole('JUDGE') && isOwner(juryId) && isNotRateLimited();
        allow delete: if hasRole('ADMIN'); // ← eklendi
      }

      match /messages/{msgId} {
        allow read: if hasRole('ADMIN') ||
                       ((hasRole('TEACHER') || hasRole('STUDENT')) && get(/databases/$(database)/documents/applications/$(appId)).data.teacher.id == request.auth.uid);
        allow create: if hasRole('ADMIN') || hasRole('TEACHER') || hasRole('STUDENT');
        allow delete: if hasRole('ADMIN'); // ← eklendi
      }
    }

    // --- 3.5 COLLECTION GROUPS ---
    match /{path=**}/scores/{scoreDocId} {
      allow read: if hasRole('ADMIN') || hasRole('JUDGE');
    }

    // --- 4. NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read:   if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || hasRole('ADMIN'); // ← eklendi
    }

    // --- 5. PUBLIC VOTES ---
    match /public_votes/{voteId} {
      allow read:   if true;
      allow create: if true;
      allow delete: if hasRole('ADMIN'); // ← eklendi
    }

    // --- 6. CONTACT MESSAGES ---
    match /contact_messages/{msgId} {
      allow read:   if hasRole('ADMIN');
      allow create: if true;
      allow update: if hasRole('ADMIN');
      allow delete: if hasRole('ADMIN'); // ← eklendi
    }

    // --- 7. AUDIT LOGS ---
    match /logs/{logId} {
      allow read:   if hasRole('ADMIN');
      allow create: if isSignedIn()
        && request.resource.data.performedBy == request.auth.token.email
        && request.resource.data.performedByUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['action', 'details', 'performedBy', 'performedByUid', 'timestamp', 'targetId', 'ip', 'userAgent', 'metadata'])
        && request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 100
        && request.resource.data.details is string && request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 2000
        && request.resource.data.timestamp is string
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('ip' in request.resource.data) || request.resource.data.ip is string)
        && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string);
      // Logs intentionally have no delete — audit trail must be immutable
    }
  }
}