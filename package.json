{
  "name": "reflect-and-shoot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "check": "npm run lint && npm run build",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --project reflect-and-shoot-test --only firestore \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run tests/firestore.rules.test.ts",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "doctor": "react-doctor --verbose",
    "doctor:score": "react-doctor --score",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "ci": "npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "verify": "npm run ci"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/s3-request-presigner": "^3.525.0",
    "@emailjs/browser": "^4.3.3",
    "@fontsource/inter": "^5.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^8.2.1",
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "firebase": "^10.9.0",
    "firebase-admin": "13.10.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.363.0",
    "motion": "^12.35.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "react-simple-maps": "^3.0.0",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.61.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.4.35",
    "react-doctor": "^0.7.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
